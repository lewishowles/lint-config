{
	"name": "@lewishowles/lint-config",
	"version": "0.8.0",
	"description": "Shared oxlint configuration for Lewis Howles projects",
	"keywords": [
		"config",
		"eslint",
		"lint",
		"oxlint",
		"shared",
		"stylistic"
	],
	"homepage": "https://github.com/lewishowles/lint-config#readme",
	"bugs": "https://github.com/lewishowles/lint-config/issues",
	"license": "MIT",
	"author": "Lewis Howles",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lewishowles/lint-config.git"
	},
	"files": [
		"CHANGELOG.md",
		"base.json",
		"comments",
		"comments.json",
		"imports.json",
		"layers.js",
		"testing",
		"vue.json",
		"README.md"
	],
	"type": "module",
	"imports": {
		"#comments/*": "./comments/*",
		"#testing/*": "./testing/*"
	},
	"exports": {
		"./base.json": "./base.json",
		"./comments.json": "./comments.json",
		"./comments/plugin": "./comments/plugin.js",
		"./imports.json": "./imports.json",
		"./layers": "./layers.js",
		"./testing/plugin": "./testing/plugin.js",
		"./vue.json": "./vue.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"lint": "vp check",
		"lint:fix": "vp check --fix",
		"prepare": "vp config --no-agent",
		"publint": "publint",
		"test:unit": "node --test test/comments/*.test.js test/layers/*.test.js test/testing/*.test.js"
	},
	"devDependencies": {
		"publint": "^0.3.22",
		"vite-plus": "1.0.0"
	},
	"peerDependencies": {
		"@stylistic/eslint-plugin": "*",
		"vite-plus": "^1.0.0"
	},
	"engines": {
		"node": ">=20"
	}
}
