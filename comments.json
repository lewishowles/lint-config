{
	"jsPlugins": [
		{
			"name": "comments",
			"specifier": "@lewishowles/lint-config/comments/plugin"
		}
	],
	"rules": {
		"comments/class-documentation": "error",
		"comments/configured-api-calls": "error",
		"comments/formatting": "error",
		"comments/function-documentation": "error",
		"comments/placement": "error",
		"comments/variable-declarations": "error",
		"comments/vue-component-documentation": "error",
		"comments/vue-emit-documentation": "error",
		"comments/vue-prop-documentation": "error"
	},
	"overrides": [
		{
			"files": ["**/*.test.*", "**/*.spec.*", "**/test/**"],
			"rules": {
				"comments/variable-declarations": ["error", { "rootOnly": true }]
			}
		}
	]
}
