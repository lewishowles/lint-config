{
	"jsPlugins": [
		{
			"name": "comments",
			"specifier": "../../../comments/plugin.js"
		}
	],
	"rules": {
		"comments/block-comments": "error",
		"comments/function-documentation": "error",
		"comments/jsdoc-tag-formatting": "error",
		"comments/line-comments": "error",
		"comments/max-line-length": "error",
		"comments/placement": "error",
		"comments/sentence-punctuation": "error",
		"comments/variable-declarations": "error",
		"comments/vue-component-documentation": "error",
		"no-unused-vars": "off"
	}
}
