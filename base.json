{
	"plugins": ["import", "oxc", "typescript", "unicorn"],
	"jsPlugins": [
		"@stylistic/eslint-plugin",
		{
			"name": "vite-plus",
			"specifier": "vite-plus/oxlint-plugin"
		},
		{
			"name": "testing",
			"specifier": "@lewishowles/lint-config/testing/plugin"
		}
	],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"builtin": true,
		"browser": true
	},
	"rules": {
		"no-case-declarations": "error",
		"no-empty": "error",
		"no-fallthrough": "error",
		"no-prototype-builtins": "error",
		"no-redeclare": "error",
		"no-regex-spaces": "error",
		"no-undef": "error",
		"no-unexpected-multiline": "error",
		"no-useless-assignment": "error",
		"preserve-caught-error": "error",
		"import/no-relative-parent-imports": "error",
		"sort-imports": [
			"error",
			{
				"ignoreDeclarationSort": true
			}
		],

		"@stylistic/no-confusing-arrow": "error",
		"@stylistic/padding-line-between-statements": [
			"error",
			{ "blankLine": "always", "prev": "*", "next": "break" },
			{ "blankLine": "always", "prev": ["const", "let"], "next": "*" },
			{ "blankLine": "always", "prev": "*", "next": ["const", "let"] },
			{ "blankLine": "always", "prev": "*", "next": "return" },
			{
				"blankLine": "always",
				"prev": ["block-like", "class", "do", "for", "function", "if", "switch", "try", "while"],
				"next": "*"
			},
			{
				"blankLine": "always",
				"prev": "*",
				"next": ["block-like", "class", "do", "for", "function", "if", "switch", "try", "while"]
			},
			{
				"blankLine": "always",
				"prev": { "selector": "ExpressionStatement[expression.type=\"AssignmentExpression\"]" },
				"next": { "selector": "ExpressionStatement[expression.type=\"CallExpression\"]" }
			},
			{
				"blankLine": "always",
				"prev": { "selector": "ExpressionStatement[expression.type=\"CallExpression\"]" },
				"next": { "selector": "ExpressionStatement[expression.type=\"AssignmentExpression\"]" }
			},
			{ "blankLine": "never", "prev": "const", "next": "const" },
			{ "blankLine": "never", "prev": "let", "next": "let" },
			{ "blankLine": "always", "prev": "multiline-const", "next": "*" },
			{ "blankLine": "always", "prev": "*", "next": "multiline-const" },
			{
				"blankLine": "always",
				"prev": "*",
				"next": { "selector": "ExpressionStatement[expression.type=\"AwaitExpression\"]" }
			},
			{
				"blankLine": "always",
				"prev": { "selector": "ExpressionStatement[expression.type=\"AwaitExpression\"]" },
				"next": "*"
			},
			{
				"blankLine": "never",
				"prev": { "selector": "ExpressionStatement[expression.type=\"AwaitExpression\"]" },
				"next": { "selector": "ExpressionStatement[expression.type=\"AwaitExpression\"]" }
			},
			{ "blankLine": "always", "prev": "multiline-expression", "next": "*" },
			{ "blankLine": "always", "prev": "*", "next": "multiline-expression" }
		],

		"vite-plus/prefer-vite-plus-imports": "error"
	},
	"overrides": [
		{
			"files": ["**/vite.config.*", "**/vitest.config.*", "**/playwright*.config.*"],
			"env": { "node": true }
		},
		{
			"files": ["**/*.test.*", "**/*.spec.*", "**/*.pw.*", "**/*.cy.*"],
			"rules": {
				"@stylistic/padding-line-between-statements": [
					"error",
					{ "blankLine": "always", "prev": "*", "next": "break" },
					{ "blankLine": "always", "prev": ["const", "let"], "next": "*" },
					{ "blankLine": "always", "prev": "*", "next": ["const", "let"] },
					{ "blankLine": "always", "prev": "*", "next": "return" },
					{
						"blankLine": "always",
						"prev": [
							"block-like",
							"class",
							"do",
							"for",
							"function",
							"if",
							"switch",
							"try",
							"while"
						],
						"next": "*"
					},
					{
						"blankLine": "always",
						"prev": "*",
						"next": ["block-like", "class", "do", "for", "function", "if", "switch", "try", "while"]
					},
					{ "blankLine": "never", "prev": "const", "next": "const" },
					{ "blankLine": "never", "prev": "let", "next": "let" },
					{ "blankLine": "always", "prev": "multiline-const", "next": "*" },
					{ "blankLine": "always", "prev": "*", "next": "multiline-const" }
				]
			}
		},
		{
			"files": ["**/*.test.*", "**/*.spec.*"],
			"rules": {
				"testing/no-text-lookups": "error"
			}
		}
	],
	"options": {
		"typeAware": false,
		"typeCheck": false
	}
}
